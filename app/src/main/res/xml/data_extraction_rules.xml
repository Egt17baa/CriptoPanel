<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the portfolio (operations and favourites) is backed up or moved to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="portfolio.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="portfolio.json" />
    </device-transfer>
</data-extraction-rules>
